# Unified vitals production template. Contains placeholders only; chmod 0600 after rendering.
VITALS_PORT=127.0.0.1:8080
APP_ORIGIN=https://vitals.localhost:9443
VITALS_ALLOW_PUBLIC_APP_ORIGIN=false
TRUST_LOOPBACK_PROXY=true
MONITOR_DB_PATH=/var/lib/vitals/monitor.db
MONITOR_MIGRATIONS_DIR=/opt/vitals/current/migrations
ALLOCATION_DB_PATH=/var/lib/vitals/allocation.db

# Monitor credential encryption only (standard base64).
CREDENTIAL_MASTER_KEYS=monitor-v1:__REPLACE_WITH_STANDARD_BASE64_32_BYTES__
CREDENTIAL_ACTIVE_KEY_ID=monitor-v1
# Allocation credential/card encryption only (raw URL base64).
ALLOCATION_CREDENTIAL_MASTER_KEYS=allocation-v1:__REPLACE_WITH_RAW_URL_BASE64_32_BYTES__
ALLOCATION_CREDENTIAL_ACTIVE_KEY_ID=allocation-v1

# Unified admin auth only. Every material must be independently generated.
ADMIN_USER=__REPLACE_WITH_ADMIN_USER__
ADMIN_PASSWORD_HASH=__REPLACE_WITH_BCRYPT_COST_12_OR_HIGHER__
ADMIN_TOTP_SECRET=__REPLACE_WITH_UNPADDED_BASE32_SECRET__
# Defaults to 720h (30 days); accepted range is 1h through 2160h.
ADMIN_SESSION_TTL=720h
JWT_SIGNING_KEY=__REPLACE_WITH_STANDARD_BASE64_32_BYTES__
RATE_LIMIT_KEY=__REPLACE_WITH_DIFFERENT_STANDARD_BASE64_32_BYTES__

# Compatibility HTTP is absent/false by default. ALLOCATION_SERVICE_API_KEY is intentionally not required.
VITALS_MONITOR_COMPAT_HTTP_ENABLED=false

# Credential refresh scheduling (OAuth/Device/Session). Enter Go duration strings.
# How often to scan for credentials that need rotation (default 1h; accepted range 1m through 24h).
VITALS_MONITOR_REFRESH_SCAN_EVERY=1h
# How long before access-token expiry a proactive refresh is triggered (default 24h; accepted range 1m through 720h).
VITALS_MONITOR_REFRESH_LEAD=24h
# Latency budget/backpressure threshold for refresh pacing (default 5m; accepted range 1s through 30m).
VITALS_MONITOR_REFRESH_MAX_LATENCY=5m

# Unified user center binding (optional). Leave all three empty to keep it disabled; anonymous redemption is unaffected.
# When enabled, UC_BIND_TICKET_KEY and UC_INTERNAL_TOKEN must both be set, each generated independently with
# `openssl rand -hex 32` (64 hex chars) and never reused from any other key. UC_DETAIL_ORIGIN is the public
# HTTPS origin of the redeem page used in detail links, e.g. https://gpt.example.com.
UC_BIND_TICKET_KEY=
UC_INTERNAL_TOKEN=
UC_DETAIL_ORIGIN=
