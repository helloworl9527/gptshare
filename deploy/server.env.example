# Copy to /etc/chatgpt-monitor/server.env, replace every placeholder, then chmod 0600.
APP_ENV=production
PORT=127.0.0.1:8080
APP_ORIGIN=https://monitor.example.com
TRUST_LOOPBACK_PROXY=true
DB_PATH=/var/lib/chatgpt-monitor/chatgpt-monitor.db
MIGRATIONS_DIR=/opt/chatgpt-monitor/current/migrations
CREDENTIAL_MASTER_KEYS=__REPLACE_WITH_KEY_ID_AND_BASE64__
CREDENTIAL_ACTIVE_KEY_ID=__REPLACE_WITH_ACTIVE_KEY_ID__
JWT_SIGNING_KEY=__REPLACE_WITH_INDEPENDENT_BASE64_KEY__
RATE_LIMIT_KEY=__REPLACE_WITH_INDEPENDENT_BASE64_KEY__
ALLOCATION_SERVICE_API_KEY=__REPLACE_WITH_ALLOCATION_SERVICE_API_KEY__
ADMIN_USER=__REPLACE_WITH_ADMIN_USER__
ADMIN_PASSWORD_HASH=__REPLACE_WITH_BCRYPT_COST_12_OR_HIGHER__
ADMIN_TOTP_SECRET=__REPLACE_WITH_BASE32_SECRET__
ADMIN_SESSION_TTL=720h
