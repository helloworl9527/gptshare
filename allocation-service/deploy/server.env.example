# allocation-service production environment template.
# Keep this file free of production secrets.

ALLOCATION_ENV=production
ALLOCATION_PORT=127.0.0.1:9090
ALLOCATION_DB_PATH=/var/lib/allocation-service/allocation.db
ALLOCATION_APP_ORIGIN=https://allocation.localhost:9444

ALLOCATION_MONITOR_BASE_URL=https://phase1.localhost:9443
ALLOCATION_MONITOR_API_KEY=__REPLACE_WITH_PHASE_ONE_ALLOCATION_SERVICE_API_KEY__

ALLOCATION_ADMIN_USER=admin
ALLOCATION_ADMIN_PASSWORD_HASH=__REPLACE_WITH_BCRYPT_HASH__
ALLOCATION_ADMIN_TOTP_SECRET=__REPLACE_WITH_BASE32_TOTP_SECRET__
ALLOCATION_SESSION_SIGNING_KEY=__REPLACE_WITH_32_BYTE_RANDOM_BASE64_OR_RAW__
ALLOCATION_CSRF_SIGNING_KEY=__REPLACE_WITH_32_BYTE_RANDOM_BASE64_OR_RAW__

# Independent phase-two credential keyring. Do not reuse any phase-one key name or material.
ALLOCATION_CREDENTIAL_MASTER_KEYS=alloc-v1:__REPLACE_WITH_32_BYTE_RANDOM_BASE64_OR_RAW__
ALLOCATION_CREDENTIAL_ACTIVE_KEY_ID=alloc-v1
