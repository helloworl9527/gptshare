[Unit]
Description=Allocation Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=allocation
Group=allocation
WorkingDirectory=/opt/allocation-service/current
EnvironmentFile=/etc/allocation-service/server.env
ExecStart=/opt/allocation-service/current/bin/allocation-service
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/allocation-service /var/log/allocation-service
RuntimeDirectory=allocation-service
RuntimeDirectoryMode=0750
StateDirectory=allocation-service
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=4096
MemoryMax=2560M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
