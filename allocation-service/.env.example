ALLOCATION_MONITOR_BASE_URL=http://127.0.0.1:8080
ALLOCATION_MONITOR_API_KEY=__REPLACE_WITH_ALLOCATION_MONITOR_API_KEY__
ALLOCATION_ACCOUNT_EVENT_API_KEY=__REPLACE_WITH_INDEPENDENT_32_BYTE_EVENT_API_KEY__
ALLOCATION_ADMIN_USER=__REPLACE_WITH_ALLOCATION_ADMIN_USER__
ALLOCATION_ADMIN_PASSWORD_HASH=__REPLACE_WITH_BCRYPT_COST_12_OR_HIGHER__
ALLOCATION_ADMIN_TOTP_SECRET=__REPLACE_WITH_BASE32_SECRET__
ALLOCATION_SESSION_SIGNING_KEY=__REPLACE_WITH_INDEPENDENT_BASE64_KEY__
